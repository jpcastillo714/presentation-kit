# Figure style of profile «night», generated from profile.yml by kit.py.
figure.figsize : 12, 5.4
figure.dpi : 100
savefig.dpi : 160
savefig.bbox : tight
savefig.facecolor : 0a1628
figure.facecolor : 0a1628
axes.facecolor : 0a1628
axes.edgecolor : 9aa8ba
axes.labelcolor : eef2f7
axes.prop_cycle : cycler('color', ['f5a623', '7fb3d5', 'c9d3df', 'e0685a'])
axes.spines.top : False
axes.spines.right : False
axes.grid : False
axes.titlesize : 18
axes.labelsize : 17
axes.titlelocation : left
xtick.color : 9aa8ba
ytick.color : 9aa8ba
xtick.labelsize : 15
ytick.labelsize : 15
text.color : eef2f7
font.family : sans-serif
font.sans-serif : Calibri, Segoe UI, DejaVu Sans
font.size : 16
legend.frameon : False
legend.fontsize : 15
lines.linewidth : 2.4
lines.markersize : 7
image.cmap : cividis
svg.fonttype : none
