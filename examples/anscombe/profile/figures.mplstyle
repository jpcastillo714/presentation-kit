# Figure style of profile «sober», generated from profile.yml by kit.py.
figure.figsize : 12, 5.4
figure.dpi : 100
savefig.dpi : 160
savefig.bbox : tight
savefig.facecolor : fbfaf7
figure.facecolor : fbfaf7
axes.facecolor : fbfaf7
axes.edgecolor : 5b6570
axes.labelcolor : 1c2127
axes.prop_cycle : cycler('color', ['1f5f8b', 'b4532a', '5b6570', '6f8f3a', '8a5a9e'])
axes.spines.top : False
axes.spines.right : False
axes.grid : False
axes.titlesize : 18
axes.labelsize : 17
axes.titlelocation : left
xtick.color : 5b6570
ytick.color : 5b6570
xtick.labelsize : 15
ytick.labelsize : 15
text.color : 1c2127
font.family : sans-serif
font.sans-serif : Segoe UI, Arial, DejaVu Sans
font.size : 16
legend.frameon : False
legend.fontsize : 15
lines.linewidth : 2.4
lines.markersize : 7
image.cmap : cividis
svg.fonttype : none
